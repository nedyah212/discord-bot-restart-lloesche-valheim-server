# Copy to /etc/valheim-bot.env (mode 600) and fill in. Never commit the real file.
# No quotes, no spaces around "=".

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Discord Developer Mode -> right-click your server icon -> Copy Server ID
# Optional, but makes slash commands appear instantly
DISCORD_GUILD_ID=

# Optional: only if your Docker container isn't named "valheim"
# VALHEIM_CONTAINER=valheim
